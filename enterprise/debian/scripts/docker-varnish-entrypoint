#!/bin/sh
set -e

# if there are arguments and the first one doesn't start with '-', run the
# user-provided command as-is, otherwise the arguments are extra varnishd flags
# (this only works if all arguments are hyphenated flags: -v; -SL; -f arg; etc.
# will work, but not arg1 arg2)
if [ "$#" -ne 0 ] && [ "${1#-}" = "$1" ]; then
    exec "$@"
fi

# all variables are expanded quoted so their values can't inject extra varnishd
# arguments, use the command line for that
VARNISH_STORAGE_BACKEND="${VARNISH_STORAGE_BACKEND:-malloc}"
if [ -f "${MSE4_CONFIG:-}" ]; then
    echo "Creating and initializing Massive Storage Engine 4 data files and stores"
    # unless asked to preserve it, wipe the cache if its format changed
    if [ "${MSE4_CACHE_FORCE_PRESERVE:-0}" -eq 0 ] 2>/dev/null; then
        mkfs.mse4 -f -c "${MSE4_CONFIG}" configure || true
    else
        mkfs.mse4 -c "${MSE4_CONFIG}" configure || true
    fi
    STORAGE="mse4,${MSE4_CONFIG}"
    VARNISH_STORAGE_BACKEND="mse4"
elif [ "${VARNISH_STORAGE_BACKEND}" = "mse4" ]; then
    STORAGE="mse4"
elif [ "${VARNISH_STORAGE_BACKEND}" = "malloc" ]; then
    STORAGE="malloc,${VARNISH_SIZE:-100M}"
else
    echo "Invalid VARNISH_STORAGE_BACKEND: ${VARNISH_STORAGE_BACKEND}" >&2
    exit 1
fi

if [ "${VARNISH_STORAGE_BACKEND}" = "mse4" ] && [ -n "${VARNISH_SIZE:-}" ]; then
    set -- -p "memory_target=${VARNISH_SIZE}" "$@"
fi

set -- varnishd \
    -F \
    -f "${VARNISH_VCL_FILE:-/etc/varnish/default.vcl}" \
    -a "http=:${VARNISH_HTTP_PORT:-80},HTTP" \
    -a "proxy=:${VARNISH_PROXY_PORT:-8443},PROXY" \
    -p feature=+http2 \
    -s "$STORAGE" \
    "$@"

exec "$@"
