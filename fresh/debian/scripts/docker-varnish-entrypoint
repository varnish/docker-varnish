#!/bin/sh
set -e

# if there are arguments and the first one doesn't start with '-', run the
# user-provided command as-is, otherwise the arguments are extra varnishd flags
# (this only works if all arguments are hyphenated flags: -v; -SL; -f arg; etc.
# will work, but not arg1 arg2)
if [ "$#" -ne 0 ] && [ "${1#-}" = "$1" ]; then
    exec "$@"
fi

# all variables are expanded quoted so their values can't inject extra varnishd
# arguments, use the command line for that
if [ "${VARNISH_STORAGE_BACKEND:-malloc}" != "malloc" ]; then
    echo "WARNING: VARNISH_STORAGE_BACKEND=${VARNISH_STORAGE_BACKEND} is not supported by this image, using malloc" >&2
fi
STORAGE="malloc,${VARNISH_SIZE-}"

set -- varnishd \
    -F \
    -f "${VARNISH_VCL_FILE:-/etc/varnish/default.vcl}" \
    -a "http=:${VARNISH_HTTP_PORT:-80},HTTP" \
    -a "proxy=:${VARNISH_PROXY_PORT:-8443},PROXY" \
    -p feature=+http2 \
    -s "$STORAGE" \
    "$@"

exec "$@"
